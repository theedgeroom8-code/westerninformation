{
  "expo": {
    "name": "Western Information Network",
    "slug": "sports-betting-edge",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sportsbettingedge",
    "userInterfaceStyle": "dark",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": {
      "url": "https://u.expo.dev/56562275-abfb-4f25-beb8-9c86956b6e4d",
      "checkAutomatically": "ON_LOAD"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#0a0a0c"
      },
      "package": "com.edgesystem.app",
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "com.edgesystem.app",
      "supportsTablet": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#F5B841",
          "defaultChannel": "edges"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "56562275-abfb-4f25-beb8-9c86956b6e4d"
      }
    },
    "owner": "edgerooms-team"
  }
}
